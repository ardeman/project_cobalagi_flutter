#!/usr/bin/env bash
set -eu

# Validate the subject only; bodies and breaking-change footers are optional.
subject=''
IFS= read -r subject < "$1" || true
subject=${subject%$'\r'}
pattern='^(feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert)(\([^()[:space:]]+\))?!?: [^[:space:]].*$'

if [[ ! $subject =~ $pattern ]]; then
  cat >&2 <<'MESSAGE'
Commit rejected: use a Conventional Commit subject.
Format: type(scope)!: description (scope and ! are optional)
Types: feat, fix, docs, style, refactor, perf, test, build, ci, chore, revert
Examples: feat(profiles): add avatar picker
          fix!: remove obsolete storage format
MESSAGE
  exit 1
fi
